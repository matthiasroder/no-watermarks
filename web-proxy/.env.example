# Store real values in the hosting platform's secret manager, never in this file.
OPENAI_API_KEY=
DEFAULT_MODEL=gpt-6.1-sol
ALLOWED_MODELS=gpt-6.1-sol
DEFAULT_INSTRUCTIONS=Write publication-ready text. Preserve supplied facts and citations. Return only the requested copy.

# Public origin of this deployment, without a trailing slash.
PUBLIC_BASE_URL=https://no-watermark.example.com

# OAuth access-token validation. Use an established OAuth 2.1 provider.
OAUTH_ISSUER=https://YOUR_TENANT.example.com/
OAUTH_AUDIENCE=https://no-watermark.example.com/mcp
OAUTH_JWKS_URI=https://YOUR_TENANT.example.com/.well-known/jwks.json
OAUTH_REQUIRED_SCOPE=no-watermark.generate
OAUTH_ALGORITHMS=RS256

# Comma-separated OAuth subject IDs allowed to charge this OpenAI project.
ALLOWED_SUBJECTS=provider|user-id

MAX_REQUESTS_PER_MINUTE=10
MAX_INPUT_CHARS=200000
MAX_INSTRUCTIONS_CHARS=20000
OPENAI_TIMEOUT_MS=180000
PORT=8787
